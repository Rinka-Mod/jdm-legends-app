[TEMPLATE]
# ============================================================
# JDM LEGENDS — Back-End
# Sao chép file này thành `.env` rồi chỉnh lại cho phù hợp.
# Khi deploy lên host (alwaysdata, Render…), KHÔNG cần file .env:
# khai báo các biến này trong phần Environment của panel host.
# ============================================================

# Cổng máy chủ API (nhiều host tự cấp biến này, khi đó bỏ dòng dưới đi)
PORT=4000

# Địa chỉ mà máy chủ lắng nghe. Để trống cũng được — mặc định 0.0.0.0.
# Host dạng shared (alwaysdata) cấp sẵn biến HOST/IP, cứ để nguyên.
# HOST=0.0.0.0

# Tên miền được phép gọi API (CORS). Nhiều tên miền thì cách nhau dấu phẩy,
# vì front-end thường nằm ở nơi khác với API:
#   CLIENT_ORIGIN=https://jdm-legends.netlify.app,https://jdm.ten-mien.net
# Giá trị "*" = cho phép mọi tên miền (chỉ nên dùng lúc thử).
CLIENT_ORIGIN=http://localhost:5173

# Khoá ký JWT — BẮT BUỘC đổi khi triển khai thật.
# Tạo khoá ngẫu nhiên dài: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=doi-thanh-mot-chuoi-ngau-nhien-rat-dai
JWT_EXPIRES_IN=7d

# Đường dẫn file SQLite (mặc định: server/data/jdm.sqlite).
# Khi deploy, nên trỏ vào thư mục nhà (home) để dữ liệu không bị mất:
#   DATABASE_PATH=/home/ten-tai-khoan/jdm-api/data/jdm.sqlite
# DATABASE_PATH=./data/jdm.sqlite
